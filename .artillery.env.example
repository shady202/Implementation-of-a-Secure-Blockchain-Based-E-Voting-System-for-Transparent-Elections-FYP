# Artillery Load Testing Environment Variables
# Copy this file to .artillery.env and update with your values

# Target URL for load testing (your backend server)
# Example: http://192.168.1.100:3001 (use your network IP for cross-device testing)
TARGET_URL=http://localhost:3001

# Test credentials (optional - for authenticated tests)
TEST_STUDENT_ID=TP123456
TEST_PASSWORD=test123
