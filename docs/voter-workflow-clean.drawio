<mxfile host="app.diagrams.net">
    <diagram id="VoterWorkflowSimple" name="Voter Workflow">
        <mxGraphModel dx="400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="400" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- Voter Actor -->
                <mxCell id="voter" value="&lt;b&gt;Voter&lt;/b&gt;&lt;br&gt;(Student)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="30" y="450" width="50" height="100" as="geometry"/>
                </mxCell>
                
                <!-- Register as Voter -->
                <mxCell id="step1" value="Register as Voter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="50" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Verify OTP -->
                <mxCell id="step2" value="Verify OTP" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="140" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Connect Wallet -->
                <mxCell id="step3" value="Connect Wallet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="230" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Register on Blockchain -->
                <mxCell id="step4" value="Register on Blockchain" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="320" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Bind Wallet -->
                <mxCell id="step5" value="Bind Wallet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="410" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Login -->
                <mxCell id="step6" value="Login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="500" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Confirm in MetaMask -->
                <mxCell id="step8" value="Confirm in MetaMask" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="680" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Vote on Blockchain -->
                <mxCell id="step9" value="Vote on Blockchain" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="770" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- Email Confirmation -->
                <mxCell id="step10" value="Email Confirmation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="860" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- View Results -->
                <mxCell id="step11" value="View Results" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="950" width="180" height="70" as="geometry"/>
                </mxCell>
                
                <!-- CAST VOTE - Primary (Larger, Darker) -->
                <mxCell id="step7" value="⑩ Cast Vote" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontSize=16;fontStyle=1;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="360" y="450" width="220" height="110" as="geometry"/>
                </mxCell>
                
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
