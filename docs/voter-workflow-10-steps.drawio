<mxfile host="app.diagrams.net">
    <diagram id="VoterWorkflow10Steps" name="Voter Workflow - 10 Steps">
        <mxGraphModel dx="850" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="400" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- Voter Actor -->
                <mxCell id="voter" value="&lt;b&gt;Voter&lt;/b&gt;&lt;br&gt;(Student)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="30" y="50" width="40" height="80" as="geometry"/>
                </mxCell>
                
                <!-- Step 1 -->
                <mxCell id="step1" value="① Register as Voter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="50" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step1" target="step2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 2 -->
                <mxCell id="step2" value="② Verify OTP" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="150" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step2" target="step3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 3 -->
                <mxCell id="step3" value="③ Connect Wallet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="250" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step3" target="step4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 4 -->
                <mxCell id="step4" value="④ Register on Blockchain" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="350" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step4" target="step5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 5 -->
                <mxCell id="step5" value="⑤ Bind Wallet to Account" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="450" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step5" target="step6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 6 -->
                <mxCell id="step6" value="⑥ Login to System" style="ellipse;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="550" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0D47A1;endArrow=classic;endFill=1;" edge="1" parent="1" source="step6" target="step7">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 7 - PRIMARY -->
                <mxCell id="step7" value="⑦ CAST VOTE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontSize=14;fontStyle=1;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="100" y="660" width="200" height="90" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step7" target="step8">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 8 -->
                <mxCell id="step8" value="⑧ Confirm Transaction in Wallet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="790" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step8" target="step9">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 9 -->
                <mxCell id="step9" value="⑨ Receive Email Confirmation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="890" width="160" height="70" as="geometry"/>
                </mxCell>
                
                <mxCell id="arrow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=classic;endFill=1;" edge="1" parent="1" source="step9" target="step10">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Step 10 -->
                <mxCell id="step10" value="⑩ View Results" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="120" y="990" width="160" height="70" as="geometry"/>
                </mxCell>
                
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
