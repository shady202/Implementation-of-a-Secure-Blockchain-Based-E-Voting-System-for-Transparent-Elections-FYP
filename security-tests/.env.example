# Security Tests Environment Configuration

# Backend API URL
API_URL=http://localhost:3001

# Blockchain Configuration
RPC_URL=https://rpc-testnet.hoodinetwork.io
CONTRACT_ADDRESS=0xYourContractAddress
CHAIN_ID=10081

# Test Accounts (Use test accounts only!)
TEST_VOTER_EMAIL=test.voter@example.com
TEST_VOTER_WALLET=0xYourTestWalletAddress
TEST_VOTER_PRIVATE_KEY=YourTestPrivateKey

TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_WALLET=0xYourAdminWalletAddress

# Database (for direct testing)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evoting_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# Test Configuration
VERBOSE_LOGGING=true
SAVE_EVIDENCE=true
