# ============================================
# APU VOTE - Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Blockchain Configuration
# ============================================
NEXT_PUBLIC_CONTRACT_ADDRESS=0x50a7daAbE0ca9ec92B5f6687dBb28e060e3E317f
NEXT_PUBLIC_CHAIN_ID=560048
NEXT_PUBLIC_NETWORK_NAME=hoodi

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Session Security
# ============================================
# IMPORTANT: Change this to a random 32+ character string in production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_SESSION_KEY=your-secure-random-session-key-change-me-in-production

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_MOCK_MODE=false
